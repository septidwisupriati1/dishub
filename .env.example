APP_NAME="KIR Antrean"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/kir-antrean

# ============================================================
# LOGGING
# ============================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=antrean_uji_kendaraan
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# BROADCASTING
# ============================================================
BROADCAST_DRIVER=log

# ============================================================
# CACHE & SESSION
# ============================================================
CACHE_DRIVER=file
CACHE_TTL=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ============================================================
# MEMCACHED
# ============================================================
MEMCACHED_HOST=127.0.0.1

# ============================================================
# REDIS
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# MAIL CONFIGURATION
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="kir-antrean@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# For production use Gmail SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=your_email@gmail.com

# ============================================================
# AWS (Optional - for file storage)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# PUSHER (Optional - for real-time notifications)
# ============================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_PUBLIC=60,1
RATE_LIMIT_API=200,1
RATE_LIMIT_ADMIN=300,1

# ============================================================
# WHATSAPP CONFIGURATION
# ============================================================
# Supported providers: twilio, fonnte, ultramsg, wablas
WHATSAPP_PROVIDER=twilio
WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
WHATSAPP_PHONE_NUMBER=+62812345678

# Twilio specific
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Fonnte specific
FONNTE_API_TOKEN=
FONNTE_API_URL=https://api.fonnte.com

# Ultramsg specific
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_API_TOKEN=

# Wablas specific
WABLAS_API_URL=https://api.wablas.com
WABLAS_API_TOKEN=

# ============================================================
# NOTIFICATION SETTINGS
# ============================================================
SEND_DAILY_NOTIFICATIONS=true
DAILY_NOTIFICATION_TIME=07:00
SEND_REMINDERS=true
REMINDER_CHECK_HOURS=24
GENERATE_DAILY_REPORTS=true
DAILY_REPORT_TIME=23:59

# ============================================================
# AUDIT & LOGGING
# ============================================================
ENABLE_AUDIT_LOG=true
LOG_API_REQUESTS=true
STORE_REQUEST_LOGS=true

# ============================================================
# SECURITY
# ============================================================
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_EXPIRATION=1440

# ============================================================
# VITE (Frontend Build Tool)
# ============================================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
